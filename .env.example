# Amazon Price Monitor configuration.
# Copy this file to .env and edit it. Never commit .env.
# Every value below is optional. With no .env at all, the application starts in mock mode.

# --- Application ---------------------------------------------------------------------------------
# Time zone used to display dates. Timestamps are stored in UTC.
TIMEZONE=America/New_York
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Address and port published on the Docker host. Keep 127.0.0.1 unless you read docs/DOCKER.md.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
# Session signing key. Leave empty: a random key is generated and stored in the data volume.
SECRET_KEY=
# Set to true only when the dashboard is served over HTTPS (for example behind a reverse proxy).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=168
# Optional bearer token for scripts that call the REST API. Leave empty to disable token access.
API_TOKEN=
# Where the database and generated secrets live. The container sets this to /app/data.
# DATA_DIR=/app/data
# Advanced: SQLAlchemy URL. Default: a SQLite file inside DATA_DIR.
# DATABASE_URL=

# --- Price provider ------------------------------------------------------------------------------
# mock (no account needed, fictional prices), canopy or apify.
PROVIDER=mock
# Optional second provider tried when the first one fails: canopy or apify. Empty disables fallback.
FALLBACK_PROVIDER=
# Seeds three clearly labelled fictional products. Requires PROVIDER=mock. Set false to remove them.
DEMO_MODE=true
HTTP_TIMEOUT_SECONDS=20
# Attempts per provider and check, including the first one. Each attempt counts against the budget.
PROVIDER_MAX_ATTEMPTS=3

# Canopy API (https://www.canopyapi.co). Used when PROVIDER or FALLBACK_PROVIDER is canopy.
CANOPY_API_KEY=
# Your own estimate of the cost of one request, in USD. Check your Canopy plan.
CANOPY_COST_PER_REQUEST_USD=0.01
CANOPY_MAX_CONCURRENCY=2
# CANOPY_BASE_URL=https://rest.canopyapi.co

# Apify (https://apify.com). Used when PROVIDER or FALLBACK_PROVIDER is apify.
APIFY_TOKEN=
# The Actor to run, as username/actor-name or an Actor ID. There is no default Actor.
APIFY_ACTOR_ID=
# JSON input for the Actor. Placeholders: {url} {asin} {marketplace} {domain}.
APIFY_INPUT_TEMPLATE={"categoryOrProductUrls": [{"url": "{url}"}], "maxItemsPerStartUrl": 1}
# Optional JSON object that maps this application's fields to the Actor's output paths.
# Keys: title brand image_url price currency list_price shipping seller in_stock condition.
APIFY_FIELD_MAP=
# Your own estimate of the cost of one Actor run, in USD.
APIFY_COST_PER_RUN_USD=0.01
# Optional hard cost cap per run, enforced by Apify (maxTotalChargeUsd).
APIFY_MAX_CHARGE_PER_RUN_USD=
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_MAX_CONCURRENCY=1
# APIFY_BASE_URL=https://api.apify.com

# --- Cost controls -------------------------------------------------------------------------------
# Paid providers are never called until you set this to true.
ALLOW_PAID_API_REQUESTS=false
# Hard monthly limit across all paid providers, in USD. Paid checks stop when it is reached.
MAX_MONTHLY_API_SPEND_USD=5.00
# Hard daily limit on paid requests (UTC day).
MAX_DAILY_API_REQUESTS=100
# How often each product is checked unless it has its own interval. 360 = every six hours.
DEFAULT_CHECK_INTERVAL_MINUTES=360

# --- Scheduler -----------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# Maximum products checked per tick. Also limits the burst after a restart.
SCHEDULER_BATCH_SIZE=5

# --- Notifications -------------------------------------------------------------------------------
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# The URL contains a secret token. Treat it like a password.
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=

# Optional email notifications.
SMTP_HOST=
SMTP_PORT=587
# starttls, ssl or none.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Records notifications in the dashboard instead of sending them. Default: on when PROVIDER=mock.
NOTIFY_MOCK_ENABLED=
